# Pooled PostgreSQL connection for the Next.js runtime.
DATABASE_URL="postgresql://user:password@pooler.example/honeydew?sslmode=require"

# Direct/session PostgreSQL connection for Prisma migrations and seeds.
DIRECT_URL="postgresql://user:password@database.example/honeydew?sslmode=require"

# Generate independent values with a cryptographically secure random generator.
APP_TOKEN_SECRET="replace-with-at-least-32-random-bytes"
PII_LOOKUP_PEPPER="replace-with-at-least-32-random-bytes"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production uses "https://honeydewbeachcamp.com" (set in the Vercel dashboard, not here).

# Local/test only. The application additionally rejects this in production.
ENABLE_DEV_PAYMENT="true"
TEST_DATABASE_URL="postgresql://user:password@127.0.0.1:5432/honeydew_test"

# Added only when the relevant integration is enabled.
# ADMIN_BOOTSTRAP_EMAIL="owner@example.com"
# CRON_SECRET=""
# PAYMENT_PROVIDER="razorpay"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# PAYMENT_WEBHOOK_SECRET=""

# Email delivery. The default provider logs messages instead of sending them,
# so local development and tests need nothing more than this.
EMAIL_PROVIDER="console"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="honeydewbeachcamp@gmail.com"
# SMTP_PASS="replace-with-gmail-app-password"
# NOTIFICATION_FROM_EMAIL="Honeydew Beach Camp <honeydewbeachcamp@gmail.com>"
# NOTIFICATION_REPLY_TO_EMAIL="honeydewbeachcamp@gmail.com"
# STAFF_ALERT_EMAIL="honeydewbeachcamp@gmail.com"
# Inbox that must approve every automated Razorpay refund with a one-time code.
# REFUND_OTP_EMAIL="kuheli.mazumdar@gmail.com"
